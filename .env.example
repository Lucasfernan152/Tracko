# Copy to .env and adjust. Empty values fall back to the defaults below.
# Inside docker compose, service hostnames are used unless you override them.

# --- Process: PostgreSQL ---
# POSTGRES_DSN=postgres://postgres:admin@localhost:5432/tracko?sslmode=disable
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=tracko
POSTGRES_SSLMODE=disable

# --- Process: MQTT ---
# MQTT_URL=tcp://localhost:1883
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=trips/+/location

# --- Process: RabbitMQ ---
# RABBITMQ_URL=amqp://tracko:tracko@localhost:5672/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=tracko
RABBITMQ_PASSWORD=tracko
RABBITMQ_QUEUE=vehicle_telemetry_queue
RABBITMQ_EXCHANGE=amq.topic
RABBITMQ_ROUTING_KEY=vehicles.*.location

# --- Process: HTTP API + WebSocket ---
# HTTP_ADDR=:8080
HTTP_PORT=8080
WS_PATH=/ws/tracking
# Set WS_ADDR to listen for WebSocket on a separate port (e.g. :8081).
# Then also publish it, e.g. TRACKO_WS_PORT=8081 and add a compose port mapping.
# WS_ADDR=

# --- Compose: ports published on the host ---
TRACKO_HTTP_PORT=8080
# TRACKO_WS_PORT=8081
MQTT_HOST_PORT=1883
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
POSTGRES_HOST_PORT=5432
